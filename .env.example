# ━━━ APP ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
APP_NAME="My SaaS"
APP_URL="http://localhost:3000"
APP_DOMAIN="localhost"
ENVIRONMENT="development"
ADMIN_EMAIL="admin@example.com"

# ━━━ DATABASE ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
POSTGRES_USER="saas_user"
POSTGRES_PASSWORD="saas_password"
POSTGRES_DB="saas_db"
DATABASE_URL="postgresql+asyncpg://saas_user:saas_password@postgres:5432/saas_db"

# ━━━ REDIS ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
REDIS_URL="redis://redis:6379"

# ━━━ AUTH ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
JWT_SECRET="change-this-to-a-random-64-char-string-minimum"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ━━━ OAUTH ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

GITHUB_AUTH_ENABLED=false
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

MICROSOFT_AUTH_ENABLED=false
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""

# ━━━ EMAIL ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
EMAIL_PROVIDER="mailhog"
EMAIL_FROM="noreply@myapp.com"
EMAIL_FROM_NAME="My SaaS"

MAILHOG_HOST=mailhog
MAILHOG_PORT=1025

RESEND_API_KEY=""
SENDGRID_API_KEY=""

SMTP_HOST=""
SMTP_PORT=587
SMTP_TLS=true
SMTP_USER=""
SMTP_PASSWORD=""


# ━━━ SUPER ADMIN ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
SUPER_ADMIN_EMAIL="admin@myapp.com"
SUPER_ADMIN_PASSWORD="changeme123"
